      "reply": { "ok": false, "code": "malformed", "message": "unknown scope" }
    },
    {
      "name": "store.roundtrip.set",
      "request": { "op": "store.set", "key": "entries", "value": [{ "dateISO": "2026-06-01", "bodyFatPct": 21.4 }] },
      "reply": { "ok": true, "data": { "ok": true } }
    },
    {
      "name": "store.roundtrip.get",
      "request": { "op": "store.get", "key": "entries" },
      "reply": { "ok": true, "data": { "key": "entries", "value": [{ "dateISO": "2026-06-01", "bodyFatPct": 21.4 }] } }
    },
    {
      "name": "store.missing",
      "request": { "op": "store.get", "key": "never-set" },
      "reply": { "ok": true, "data": { "key": "never-set", "value": null } }
    },
    {
      "name": "ingest.read",
      "request": { "op": "ingest.read", "limit": 2 },
      "reply": { "ok": true, "data": { "docs": [{ "id": "ing_1", "receivedISO": "2026-06-08T14:01:00Z", "source": "email", "fields": { "weightKg": "78.2", "bodyFatPct": "21.4" } }], "synthetic": false } }
    },
    {
      "name": "signal.ok",
      "request": { "op": "signal", "event": "chart_viewed", "context": { "surface": "tile" } },
      "reply": { "ok": true, "data": { "ok": true } }
    },
    {
      "name": "signal.unknown.event",
      "request": { "op": "signal", "event": "totally_made_up" },
      "reply": { "ok": false, "code": "malformed", "message": "unknown signal event" }
    },
    {
      "name": "feedback.ok",
      "request": { "op": "feedback", "kind": "helped" },
      "reply": { "ok": true, "data": { "ok": true } }
    },
    {
      "name": "unknown.op",
      "request": { "op": "launch_missiles" },
      "reply": { "ok": false, "code": "unknown_op", "message": "unknown op: launch_missiles" }
    }
  ],
