  "signalEvents": ["open", "expand", "interact", "chart_viewed", "entry_added", "error"],
  "errorCodes": ["scope_denied", "rate_limited", "unknown_op", "malformed", "unavailable"],
  "limits": { "storeValueBytes": 65536, "storeKeyChars": 128, "feedbackNoteChars": 280, "signalPerSession": 60 },
  "golden": [
    {
      "name": "context",
      "request": { "op": "context" },
