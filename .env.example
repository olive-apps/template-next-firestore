# Olive app identifier. The provisioning endpoint sets this when the repo is
# created. Every Firestore document the app reads or writes is scoped under
# /apps/{NEXT_PUBLIC_OLIVE_APP_ID}/* — security rules enforce this server-side.
NEXT_PUBLIC_OLIVE_APP_ID=

# Base64-encoded Firebase service account JSON. Decoded once at build/runtime
# and passed to firebase-admin. Generated and injected by the provisioning
# endpoint at deploy time; never commit a real value.
FIREBASE_SERVICE_ACCOUNT_JSON=
