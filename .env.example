# Olive app identifier. The deployer sets this at build time. Every Firestore
# document the app reads or writes is scoped under /apps/{NEXT_PUBLIC_OLIVE_APP_ID}/*
# — security rules enforce the boundary server-side.
NEXT_PUBLIC_OLIVE_APP_ID=u_bill1-tasks-app

# Base64-encoded per-app credential envelope minted by api-pipeline's
# mintPerAppFirebaseCredential. The Firebase Web SDK decodes this at boot and
# calls signInWithCustomToken to enter an authenticated session whose appId
# claim gates Firestore reads. 24-hour TTL; rebuild + redeploy to refresh.
NEXT_PUBLIC_FIREBASE_CUSTOM_TOKEN_B64=

# Public Firebase Web SDK config for the api-pipeline-prod-231c3 project.
# Not secret — these only identify which Firebase project the client talks to.
# The template defaults to the production project's values; override only when
# pointing a local build at a different Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBGjiX0fEZjB-t-utzZ-lN2tlm3_lLLOSU
NEXT_PUBLIC_FIREBASE_WEB_APP_ID=1:111402115888:web:09cdbbc21e80c827d91ef5
